# .env — local secrets. Copy to .env (git-ignored) and fill in what you use.
# In GitHub Actions, add the same names as repository secrets instead.

# Gmail alerts (required for email). App Password, not your normal password:
# Google Account → Security → 2-Step Verification → App passwords.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
# Where alerts go (optional, defaults to GMAIL_USER).
ALERT_TO=

# LinkedIn/Indeed discovery via Apify (optional, paid, capped at $0.10/scan).
# https://console.apify.com → Settings → API & Integrations → Personal API tokens
APIFY_TOKEN=

# AI fit notes in the alert email (optional). https://console.anthropic.com
ANTHROPIC_API_KEY=

# Allow the MCP server to run paid (Apify) scans when an agent asks (optional).
# RADAR_MCP_ALLOW_APIFY=1
