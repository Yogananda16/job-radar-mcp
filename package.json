{
  "name": "job-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "scan": "node src/cli.mjs",
    "alert": "node src/main.mjs",
    "test-email": "node src/main.mjs --test-email",
    "mcp": "node src/mcp/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check": "npm run check:secrets && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dotenv": "^18.0.8",
    "js-yaml": "^5.5.0",
    "nodemailer": "^10.2.1",
    "undici": "^6.29.1",
    "zod": "^4.6.7"
  },
  "description": "Hourly alerts for freshly posted jobs that match your profile: verified at the employer, never reposts, zero LLM in the scan.",
  "license": "MIT",
  "bin": {
    "job-radar": "src/cli.mjs"
  }
}
